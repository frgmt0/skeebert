# Copy to .env and fill in. Never commit .env.

# Discord bot token (developer portal -> your app -> Bot -> Reset Token).
SKEEBERT_DISCORD_TOKEN=
# Optional: a test server id. Slash commands sync to it instantly instead of globally.
SKEEBERT_DEV_GUILD_ID=

# Anthropic API key for the brain. Leave empty to run on the local (sleeping) brain only.
ANTHROPIC_API_KEY=
# Brain model id. The default is UNVERIFIED (no live call was made when it was written).
SKEEBERT_BRAIN_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
SKEEBERT_BRAIN_EFFORT=low
SKEEBERT_BRAIN_MAX_TOKENS=1024
SKEEBERT_BRAIN_TIMEOUT_SECONDS=20

# Daily brain budget in USD per UTC day. When it's spent, Skeebert falls asleep until the next UTC day.
SKEEBERT_DAILY_BUDGET_USD=6.00
# Brain calls per person per hour before that person gets the sleeping brain.
SKEEBERT_RATE_LIMIT_PER_HOUR=30

# Prices in USD per million tokens (Claude Haiku 5.5, prompts <=100K tokens, launch coverage Oct 7 2026).
# Verify on Anthropic's pricing page and update if they changed.
SKEEBERT_PRICE_INPUT_PER_MTOK=0.10
SKEEBERT_PRICE_OUTPUT_PER_MTOK=0.50
SKEEBERT_PRICE_CACHE_READ_PER_MTOK=0.01
SKEEBERT_PRICE_CACHE_WRITE_PER_MTOK=0.125

# Where things live. data/ holds real people's data and the hash salt on the bot's machine.
SKEEBERT_DATA_DIR=data
SKEEBERT_CHECKPOINT_DIR=checkpoints
SKEEBERT_RENDERS_DIR=renders

# Torch device for drawing glyphs (cpu is plenty for serving).
SKEEBERT_DEVICE=cpu
SKEEBERT_SITE_URL=https://skeebert.frgmt.xyz
